# =============================================================================
# ColdScan environment variables
#
# Local dev: copy this file to `.env` and fill in the values.
# Vercel:    set each one in Project > Settings > Environment Variables
#            (all environments).
#
# These are read SERVER-SIDE ONLY (the `api/` functions). Never prefix any of
# them with VITE_ — that would inline the value into the browser bundle.
# `.env` is git-ignored; never commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# GEMINI_API_KEY (required)
# Used for every Gemini call: fridge scanning, recipes, TTS, and minting the
# ephemeral tokens for the Live voice session.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# TRIAL_SECRET (required in production)
# Signing key for the free trial. It signs the HttpOnly session cookie and
# derives the opaque identifiers used instead of storing raw emails or IPs.
#
# Easiest way to set this up (generates it and pushes it to Vercel for you,
# with a separate value for Production and Preview):
#     bash scripts/setup-trial-env.sh
#
# Or by hand — at least 32 random characters:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Rotating this value invalidates every existing session cookie and email link,
# which effectively grants everyone a fresh trial — only rotate deliberately.
# Without it, deployed requests fail closed; local dev falls back to a random
# per-process key and warns.
# -----------------------------------------------------------------------------
TRIAL_SECRET=""

# -----------------------------------------------------------------------------
# Trial store (required in production)
# Where the server-side trial start times live. Vercel functions are stateless,
# so this must be a shared datastore or the trial cannot be enforced.
#
# ON VERCEL: connecting an Upstash database from the Marketplace sets these
# automatically for Production, Preview and Development. You do not need to
# copy anything — leave the entries below empty locally unless you want local
# dev to share the deployed database.
#
# The app accepts either pair: UPSTASH_REDIS_REST_* (native Upstash resource)
# or KV_REST_API_* (Vercel KV-style binding). /api/health reports which it found
# via trial.storeBinding. Keys are namespaced `coldscan:trial:*`, so the same
# database can safely be shared with other apps.
#
# To mirror the deployed database locally:  npx vercel env pull .env.local
#
# Without these the server falls back to an in-memory map: fine for local dev,
# useless in production (each serverless instance would have its own copy).
# Check /api/health -> trial.storeConfigured.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# TRIAL_ACCESS_CODES (optional)
# The codes you hand out after someone contacts you once their trial ends.
# Comma-separated, each entry either:
#     CODE:unlock            -> permanent full access
#     CODE:extend:<hours>    -> that many extra hours
#
# Example (invent your own, do not reuse these):
#     TRIAL_ACCESS_CODES="8FJ2-QW71:unlock,K93M-2RTX:extend:48"
#
# Codes are compared as HMACs keyed with TRIAL_SECRET and are never sent to the
# browser. Leave empty and no code can be redeemed.
# -----------------------------------------------------------------------------
TRIAL_ACCESS_CODES=""

# -----------------------------------------------------------------------------
# PORT: local dev server only. Vercel handles routing in production.
# -----------------------------------------------------------------------------
PORT=3000
