# GEMINI_API_KEY: Required for all Gemini API calls (scanning, recipes, TTS, and
# minting the ephemeral tokens used by the Live voice session).
#
# Local dev: copy this file to `.env` and paste your key below.
# Vercel:    set it in Project > Settings > Environment Variables (all environments).
#
# This key is only ever read server-side (the `api/` functions). It is never
# exposed to the browser — do NOT prefix it with VITE_, which would inline it
# into the client bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Local dev server port only. Vercel handles routing in production.
PORT=3000
